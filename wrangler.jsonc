{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jlogicsoftware-web",
	"main": "worker/index.js",
	"compatibility_date": "2026-07-23",
	"vars": {
		"ACCESS_TEAM_DOMAIN": "old-flower-c867.cloudflareaccess.com",
		"ACCESS_AUD": "d6e5b0410b5e62a5e40653cca7ee7f8bc540343ecdf6c7bf0fedbc18f3ee6888"
	},
	// STATS_ALLOWED_EMAIL is a private Worker secret, never a source-controlled variable.
	"observability": {
		"enabled": false
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/index",
			"/index.html",
			"/about",
			"/about.html",
			"/development",
			"/development.html",
			"/privacy",
			"/privacy.html",
			"/articles",
			"/articles.html",
			"/api/*",
			"/stats*",
			"/about/",
			"/development/",
			"/privacy/",
			"/articles/",
			"/articles/2026-09-18-how-i-made-bugeater-3x-faster",
			"/articles/2026-09-18-how-i-made-bugeater-3x-faster/"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jlogicsoftware-analytics",
			"database_id": "97697ed2-a230-43c4-a63f-8d421def1861"
		}
	],
	"ratelimits": [
		{
			"name": "STATS_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	}
}
